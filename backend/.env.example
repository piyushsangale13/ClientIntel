APP_NAME=ClientIntel FastAPI
APP_ENV=development
DEBUG=true
PORT=8000
API_V1_PREFIX=/api
CORS_ORIGINS=["*"]

DATABASE_URL=postgresql+psycopg://clientintel:clientintel@postgres:5432/clientintel
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=company_research_chunks

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

OPEN_AI_API_KEY=your_openai_api_key
OPEN_AI_CHAT_MODEL=gpt-4.1-mini
OPEN_AI_EMBEDDING_MODEL=text-embedding-3-large
OPEN_AI_EMBEDDING_DIMENSIONS=3072

GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_google_cse_id
